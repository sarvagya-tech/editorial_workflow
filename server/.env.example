# Neon / PostgreSQL Database URL
# Example: postgres://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editorial_workflow?schema=public"

# JWT Secret for authentication
JWT_SECRET="editorial-workflow-super-secret-jwt-key-2026"

# Port
PORT=5000

# Cron Secret for internal publishing worker API triggers
CRON_SECRET="dispatch-internal-cron-secret-2026"

# Autonomous Background Scheduler Worker Configuration
ENABLE_SCHEDULER_WORKER="true"
SCHEDULER_INTERVAL_MS="30000"
