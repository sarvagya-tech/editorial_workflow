{
  "name": "editorial-workflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed",
    "prisma:studio": "npm --prefix server run prisma:studio",
    "test": "npm --prefix server run test",
    "test:db": "npm --prefix server run test:db",
    "test:auth": "npm --prefix server run test:auth",
    "test:sections": "npm --prefix server run test:sections",
    "test:articles": "npm --prefix server run test:articles",
    "test:workflow": "npm --prefix server run test:workflow",
    "test:search": "npm --prefix server run test:search",
    "test:bulk": "npm --prefix server run test:bulk",
    "test:dashboard": "npm --prefix server run test:dashboard",
    "test:alerts": "npm --prefix server run test:alerts",
    "test:scheduled": "npm --prefix server run test:scheduled",
    "test:all": "npm --prefix server run test:all"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
